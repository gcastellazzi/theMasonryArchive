# Segreti per `wrangler dev`. Escluso dal versionamento da `.env*` in .gitignore.
# In produzione questi valori si impostano con `npx wrangler secret put <NOME>`.
JWT_SECRET = "sviluppo-locale-non-usare-in-produzione"
ADMIN_TOKEN = "admin-locale"
# RESEND_API_KEY assente di proposito: in sviluppo il magic link
# viene stampato nel log invece di essere spedito.
